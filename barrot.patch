 }
 
+/* Barrot BR8554/BR8654 advertise LE extended advertising but mixing it with
+ * legacy scan commands gets them disallowed, so hide the feature bit.
+ */
+static int btusb_recv_event_barrot(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct hci_ev_cmd_complete *cc;
+	u8 *rp;
+
+	if (skb->len >= HCI_EVENT_HDR_SIZE + sizeof(*cc) + 1 + 8 &&
+	    skb->data[0] == HCI_EV_CMD_COMPLETE) {
+		cc = (void *)(skb->data + HCI_EVENT_HDR_SIZE);
+		rp = skb->data + HCI_EVENT_HDR_SIZE + sizeof(*cc);
+		if (__le16_to_cpu(cc->opcode) == HCI_OP_LE_READ_LOCAL_FEATURES &&
+		    rp[0] == 0x00) {
+			rp[1 + 1] &= ~(HCI_LE_EXT_ADV | HCI_LE_PERIODIC_ADV);
+			bt_dev_info(hdev, "Barrot: hiding LE extended advertising");
+		}
+	}
+
+	return hci_recv_frame(hdev, skb);
+}
