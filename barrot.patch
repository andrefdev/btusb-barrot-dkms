+static int btusb_recv_event_barrot(struct hci_dev *hdev, struct sk_buff *skb);
+
+static void btusb_barrot_inject_evt(struct hci_dev *hdev, u8 evt,
+				    const void *data, u8 len)
+{
+	struct sk_buff *skb;
+
+	skb = bt_skb_alloc(HCI_EVENT_HDR_SIZE + len, GFP_ATOMIC);
+	if (!skb)
+		return;
+
+	hci_skb_pkt_type(skb) = HCI_EVENT_PKT;
+	skb_put_u8(skb, evt);
+	skb_put_u8(skb, len);
+	skb_put_data(skb, data, len);
+	hci_recv_frame(hdev, skb);
+}
+
+/* Barrot BR8554/BR8654 answer LE Read Remote Used Features with Controller
+ * Busy right after connecting, which aborts pairing. Complete it locally.
+ */
+static bool btusb_barrot_fake_remote_feat(struct hci_dev *hdev,
+					  struct sk_buff *skb)
+{
+	struct btusb_data *data = hci_get_drvdata(hdev);
+	struct hci_command_hdr *hdr;
+	struct hci_ev_cmd_status cs;
+	struct {
+		u8 subevent;
+		struct hci_ev_le_remote_feat_complete ev;
+	} __packed fc = {};
+
+	if (data->recv_event != btusb_recv_event_barrot ||
+	    skb->len < HCI_COMMAND_HDR_SIZE + 2)
+		return false;
+
+	hdr = (void *)skb->data;
+	if (__le16_to_cpu(hdr->opcode) != HCI_OP_LE_READ_REMOTE_FEATURES)
+		return false;
+
+	cs.status = 0x00;
+	cs.ncmd = 1;
+	cs.opcode = hdr->opcode;
+
+	fc.subevent = HCI_EV_LE_REMOTE_FEAT_COMPLETE;
+	fc.ev.status = 0x00;
+	memcpy(&fc.ev.handle, skb->data + HCI_COMMAND_HDR_SIZE, 2);
+	fc.ev.features[0] = HCI_LE_ENCRYPTION;
+
+	bt_dev_info(hdev, "Barrot: faking LE Read Remote Used Features");
+	kfree_skb(skb);
+
+	btusb_barrot_inject_evt(hdev, HCI_EV_CMD_STATUS, &cs, sizeof(cs));
+	btusb_barrot_inject_evt(hdev, HCI_EV_LE_META, &fc, sizeof(fc));
+	return true;
+}
